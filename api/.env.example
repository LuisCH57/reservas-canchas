# Copia este archivo como ".env" y reemplaza los valores con los tuyos.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Cadena de conexión de Neon del proyecto "reservas-canchas".
# Al final, deja solo: ?sslmode=verify-full
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@SERVIDOR.neon.tech/neondb?sslmode=verify-full

# Clave secreta para firmar los tokens (JWT). Larga y aleatoria. Genérala con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Puerto donde escucha la API en tu computadora
PORT=3000

# Sitios web que pueden usar la API desde el navegador (separados por comas)
CORS_ORIGIN=
